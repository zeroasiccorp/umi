# Formal proof: umi_buffer vs the README 4.2 handshake rules, plus
# payload identity -- that the beats coming out are the beats that went
# in, unchanged and in order.
#
# Run from this directory (needs yosys + SymbiYosys + a solver, e.g.
# the OSS CAD Suite):
#
#   sby -f fv_umi_buffer.sby prove           # skid buffer: expect PASS
#   sby -f fv_umi_buffer.sby prove_z3        # same proof, second solver
#   sby -f fv_umi_buffer.sby bypass          # MODE=0: expect PASS
#   sby -f fv_umi_buffer.sby cover           # witnesses: expect all reached
#   sby -f fv_umi_buffer.sby rule5           # rule 4.2.5 witness: expect PASS
#   sby -f fv_umi_buffer.sby prove_mask_off  # RULE_EN=0: expect PASS
#   sby -f fv_umi_buffer.sby identity        # payload identity: expect PASS
#   sby -f fv_umi_buffer.sby identity_bypass # MODE=0 identity: expect PASS
#   sby -f fv_umi_buffer.sby identity_cover  # witnesses: expect all reached
#   sby -f fv_umi_buffer.sby fault_valid     # checker teeth: expect FAIL
#   sby -f fv_umi_buffer.sby fault_data      # checker teeth: expect FAIL
#   sby -f fv_umi_buffer.sby fault_rule5     # rule5 teeth: expect FAIL
#   sby -f fv_umi_buffer.sby fault_swap      # identity teeth: expect FAIL
#
# prove tasks use k-induction: a PASS is an unbounded proof, not a
# bounded search. The fault tasks corrupt the observed output and MUST
# fail -- they are the checker's own regression (a checker that cannot
# fail a broken design proves nothing about a working one).
#
# The two identity tasks are the exception to the engine rule: they run
# `abc pdr`, which is also unbounded but derives its own invariant over
# the design's registers instead of being handed one at the ports. The
# harness header says why k-induction cannot close a_id_beat -- the skid
# register is not port-observable -- and the failing label it reports
# when tried. No environment assumption stands behind either task; the
# identity laws are proven under the same legal-SUMI stimulus as the
# handshake ones, with no bound on how long READY may stay low.
#
#   identity        a_id_occupancy + a_id_beat, MODE=1 (skid buffer)
#   identity_bypass the same two labels, MODE=0 (combinational bypass)
#   identity_cover  the tracked beat is really delivered (c_id_deliver)
#                   and the skid slot is really used (c_id_full), so
#                   neither law is passing vacuously
#   fault_swap      FV_FAULT_SWAP exchanges DSTADDR and SRCADDR on the
#                   OBSERVED beat only. The swap is static, so VALID
#                   still holds and the payload is still stable across a
#                   stall: every handshake rule survives it and the
#                   tripped label is a_id_beat alone. That corruption is
#                   exactly what the handshake tasks cannot see, which is
#                   why these laws are here.
#
# The identity tasks run a narrower face than the rest of this file,
# AW=16 and DW=32, because PDR relates the payload registers bit by bit.
# The law is width-agnostic -- the datapath is bit-parallel -- and the
# one chparam line below is the whole change needed to widen it; the
# harness defaults (AW=64, DW=64) close too, about five times slower.
#
# prove_mask_off is the soundness check for the per-rule mask itself: it
# is the fault_valid configuration with every rule masked off. The
# corruption that trips RULE2_valid_hold is still injected, so leaving
# any rule outside its RULE_EN guard turns this task straight back into
# fault_valid. It passes only if the mask really removes every
# obligation the checker would otherwise raise -- the exact complement
# of that task. The DUT-level a_rule5_state assertion is not a checker
# rule and stays live, which is what keeps the task a proof and not an
# empty one.
#
# rule 4.2.5 (README.md:462) -- "the assertion of VALID must not depend
# on the assertion of READY" -- is proven on the DUT in three parts:
#   rule5        cover: out_ready ASSUMED 0 every cycle (FV_RULE5_READYLOW),
#                upstream stays legal, COVER out_valid asserting-and-held.
#                Reaching it proves VALID rises with zero help from READY.
#                a_rule5_state (occupancy => out_valid) also rides the
#                prove/prove_z3/bypass tasks as the state-driven face.
#   fault_rule5  teeth: FV_FAULT_RULE5 models the illegal design where
#                VALID waits for READY (out_valid & out_ready). Under
#                stuck-low ready the covered signal is 0 forever, so:
#                  c_rule5_valid_stuck_low   UNREACHED  (the tripped label)
#                  c_rule5_valid_held        UNREACHED
#                and the task FAILs -- the honest `rule5` cover has teeth.
# Both rule5 tasks pass -DFV_NO_WITNESS so the handshake checker's own
# transaction covers (valid & ready), unreachable under stuck-low ready,
# do not spuriously fail the cover task.

[tasks]
prove            smt
prove_z3
bypass           smt
cover            smt
rule5            smt
prove_mask_off   smt
identity         id pdr
identity_bypass  id pdr
identity_cover   id smt
fault_valid      smt
fault_data       smt
fault_rule5      smt
fault_swap       id smt

[options]
prove: mode prove
prove_z3: mode prove
bypass: mode prove
cover: mode cover
rule5: mode cover
prove_mask_off: mode prove
identity: mode prove
identity_bypass: mode prove
identity_cover: mode cover
fault_valid: mode bmc
fault_data: mode bmc
fault_rule5: mode cover
fault_swap: mode bmc
depth 12
timeout 300

# the tags in [tasks] name the engine each task wants: `smt` is the
# boolector default, `pdr` is the identity proof (see above)
[engines]
prove_z3: smtbmc z3
pdr: abc pdr
smt: smtbmc boolector

[script]
rule5: verilog_defines -DFV_NO_WITNESS
fault_rule5: verilog_defines -DFV_NO_WITNESS
read_verilog -formal -sv umi_handshake_checker.sv
read_verilog -sv umi_buffer.v
fault_valid: read_verilog -formal -sv -DFV_FAULT_VALID fv_umi_buffer.sv
fault_data: read_verilog -formal -sv -DFV_FAULT_DATA fv_umi_buffer.sv
rule5: read_verilog -formal -sv -DFV_RULE5_READYLOW fv_umi_buffer.sv
fault_rule5: read_verilog -formal -sv -DFV_RULE5_READYLOW -DFV_FAULT_RULE5 fv_umi_buffer.sv
fault_swap: read_verilog -formal -sv -DFV_IDENTITY -DFV_FAULT_SWAP fv_umi_buffer.sv
identity: read_verilog -formal -sv -DFV_IDENTITY fv_umi_buffer.sv
identity_bypass: read_verilog -formal -sv -DFV_IDENTITY fv_umi_buffer.sv
identity_cover: read_verilog -formal -sv -DFV_IDENTITY fv_umi_buffer.sv
prove: read_verilog -formal -sv fv_umi_buffer.sv
prove_z3: read_verilog -formal -sv fv_umi_buffer.sv
cover: read_verilog -formal -sv fv_umi_buffer.sv
bypass: read_verilog -formal -sv fv_umi_buffer.sv
prove_mask_off: read_verilog -formal -sv -DFV_FAULT_VALID fv_umi_buffer.sv
bypass: chparam -set MODE 0 fv_umi_buffer
identity_bypass: chparam -set MODE 0 fv_umi_buffer
prove_mask_off: chparam -set RULE_EN 0 fv_umi_buffer
id: chparam -set AW 16 -set DW 32 fv_umi_buffer
prep -top fv_umi_buffer

[files]
../../sumi/umi_buffer/rtl/umi_buffer.v
../../sumi/umi_checker/rtl/umi_handshake_checker.sv
fv_umi_buffer.sv
